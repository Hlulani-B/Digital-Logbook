# project-service environment variables
# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# All values below are examples; the Supabase project ref in the URLs is real
# (it is already public in the frontend bundle and JWTs).

# ── Core ─────────────────────────────────────────────────────────────
# HTTP port the service listens on
PORT=5003

# Direct PostgreSQL connection (pool in src/db.js). Also used by the
# migration runner at ../../scripts/migrate.js. Get it from the Supabase
# dashboard → Project Settings → Database → Connection string (URI format).
DATABASE_URL=postgresql://postgres:[password]@db.bsfbkprmwiwxqxdwisxb.supabase.co:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────────
# Project URL + service-role key (bypasses RLS — server side only)
SUPABASE_URL=https://bsfbkprmwiwxqxdwisxb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Storage bucket for note attachments (created in the Supabase dashboard)
SUPABASE_STORAGE_BUCKET=Hlulani

# JWT verification for requireAuth (src/middleware/auth.js). Defaults to the
# URL below for this project — only set this when pointing at a different
# Supabase project.
SUPABASE_JWKS_URL=https://bsfbkprmwiwxqxdwisxb.supabase.co/auth/v1/.well-known/jwks.json

# ── Notification emails (Brevo) ──────────────────────────────────────
# Due-soon / overdue alerts (src/functions/notifications). Without these,
# notification rows still generate and the in-app bell works — only emails
# are skipped (rows stay emailed=false and retry hourly).
# Dashboard → SMTP & API → API Keys. Free tier: 300 emails/day.
BREVO_API_KEY=xkeysib-...
# Must be a verified sender/domain in Brevo or the API rejects with 400.
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# ── AI providers (optional) ──────────────────────────────────────────
# Natural-language entry parsing / AI categorization. The service tries each
# provider in turn; without any key those features return a graceful error.
HF_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
