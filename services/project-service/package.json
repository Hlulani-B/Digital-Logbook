{
  "name": "project-service",
  "version": "1.0.0",
  "description": "Project Service microservice",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.0.0",
    "@google/generative-ai": "^0.21.0",
    "@huggingface/inference": "^3.0.0",
    "@neondatabase/serverless": "^1.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.0.12",
    "leven": "^3.1.0",
    "openai": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "coverage-badges-cli": "^2.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^date-fns$": "<rootDir>/node_modules/date-fns/index.cjs"
    },
    "collectCoverageFrom": [
      "src/functions/**/*.js",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ]
  }
}
